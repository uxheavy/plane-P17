# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Backend (Django) configuration. Consumed by docker-compose-local.yml and
# docker-compose-test.yml through the development lifecycle, which resolves this
# schema with `varlock run`.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Set to 0 outside development.
# @type=boolean @auditIgnore
DEBUG=0

# Cross-origin browsers this API answers. It is a comma-separated list of
# origins and is only consulted for cross-origin requests.
#
# The development lifecycle overrides this with the allocated web port, so the
# browser origin the stack actually serves is the one that is permitted. The
# values below are the upstream defaults, which apply when the web client runs
# on its documented port rather than from an allocation (ADR-0009).
# @type=string @auditIgnore
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# ---------------------------------------------------------------------------
# Database
#
# The defaults address the Compose network. The development lifecycle overrides
# POSTGRES_HOST with a loopback address for host-side access.
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
POSTGRES_USER="plane"

# @public @auditIgnore
POSTGRES_PASSWORD="company-runner-dev"

# @type=string @auditIgnore
POSTGRES_HOST="plane-db"

# @type=string @auditIgnore
POSTGRES_DB="plane"

# @type=port @auditIgnore
POSTGRES_PORT=5432

# @type=string @auditIgnore
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
REDIS_HOST="plane-redis"

# @type=port @auditIgnore
REDIS_PORT="6379"

# @type=string @auditIgnore
REDIS_URL="redis://${REDIS_HOST}:6379/"

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
RABBITMQ_HOST="plane-mq"

# @type=port @auditIgnore
RABBITMQ_PORT="5672"

# @type=string @auditIgnore
RABBITMQ_USER="plane"

# @public @auditIgnore
RABBITMQ_PASSWORD="company-runner-dev"

# @type=string @auditIgnore
RABBITMQ_VHOST="plane"

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
AWS_REGION=""

# @public @auditIgnore
AWS_ACCESS_KEY_ID="access-key"

# @public @auditIgnore
AWS_SECRET_ACCESS_KEY="secret-key"

# @type=url @auditIgnore
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"

# Changing this requires a matching change in the proxy config for uploads when
# using the MinIO setup.
# @type=string @auditIgnore
AWS_S3_BUCKET_NAME="uploads"

# Maximum file upload limit, in bytes.
# @type=number @auditIgnore
FILE_SIZE_LIMIT=5242880

# Signed URL expiry, in seconds.
# @type=number @auditIgnore
SIGNED_URL_EXPIRATION=3600

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Django secret key. Generated per installation; the development value is a
# placeholder, not a credential.
# @public @auditIgnore
SECRET_KEY="secret-key"

# @public @auditIgnore
LIVE_SERVER_SECRET_KEY="secret-key"

# @type=string @auditIgnore
WEBHOOK_ALLOWED_HOSTS=""

# ---------------------------------------------------------------------------
# Service URLs and base paths
# ---------------------------------------------------------------------------

# @type=url @auditIgnore
WEB_URL="http://localhost:8000"

# @type=url @auditIgnore
ADMIN_BASE_URL="http://localhost:3001"

# @type=string @auditIgnore
ADMIN_BASE_PATH="/god-mode"

# @type=url @auditIgnore
SPACE_BASE_URL="http://localhost:3002"

# @type=string @auditIgnore
SPACE_BASE_PATH="/spaces"

# @type=url @auditIgnore
APP_BASE_URL="http://localhost:3000"

# @type=string @auditIgnore
APP_BASE_PATH=""

# @type=url @auditIgnore
LIVE_BASE_URL="http://localhost:3100"

# @type=string @auditIgnore
LIVE_BASE_PATH="/live"

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------

# @type=number @auditIgnore
GUNICORN_WORKERS=2

# Hard-delete files after this many days.
# @type=number @auditIgnore
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS when SSL termination is handled upstream.
# @type=boolean @auditIgnore
MINIO_ENDPOINT_SSL=0

# @type=string @auditIgnore
API_KEY_RATE_LIMIT="60/minute"

# Set to 1 when using the pre-configured MinIO setup.
# @type=boolean @auditIgnore
USE_MINIO=0

# Upstream marks this as deprecated and no current code reads it.
# @optional @type=string @auditIgnore
DOCKERIZED="1"

# Celery broker URL, composed from the broker parts so the value always matches
# the credentials the stack actually runs with. It must not be empty: the
# release Compose interpolates it as `${AMQP_URL:-amqp://plane:plane@...}`,
# and Compose's `:-` treats an empty value as unset and falls back to that
# literal, which carries the placeholder credentials packaging rejects.
# @type=string
AMQP_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}"

# Identifies the agent profile that Plane calls back into when it needs to wake
# an agent. Present but empty by default; packaging requires a canonical UUID.
# @optional @type=string
AGENT_PROFILE_WEBHOOK_ID=""
