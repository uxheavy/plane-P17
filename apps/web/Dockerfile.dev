# The workspace declares `engines.node >= 22.22.0`. Pinning the minor keeps the
# build from silently floating below it, while staying on the upstream 22.x
# alpine convention used by the other Dockerfiles.
FROM node:22.22-alpine

RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

# pnpm installs its global bin outside the default PATH. Without this, the
# `pnpm add -g` below fails with "The configured global bin directory is not in
# PATH". Dockerfile.web configures the same pair.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"

COPY . .
RUN corepack enable pnpm && pnpm add -g turbo
RUN pnpm install

EXPOSE 3000
# The web package lives under apps/ after the workspace restructure. The second
# mount keeps the workspace's own node_modules (pnpm's isolated linker places
# package-level dependencies there) from being shadowed by the host bind mount
# in docker-compose-development.yml.
VOLUME [ "/app/node_modules", "/app/apps/web/node_modules" ]
CMD ["pnpm", "dev", "--filter=web"]
