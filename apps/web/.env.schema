# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Web client (Vite / React Router) configuration.
#
# `vite.config.ts` reads DEV_BACKEND_URL from the process environment, not from
# import.meta, so it is resolved by the development lifecycle rather than by
# Vite's own env loading. Inside the development stack it names the `api`
# service on the Compose network; on a host-run dev server it names the
# allocated loopback port.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# Backend origin the Vite dev server proxies /api, /auth, /static, /uploads,
# and /live to. Leave unset to serve the client without a proxy.
#
# Read by apps/web/vite.config.ts through `process.env.DEV_BACKEND_URL` at config
# evaluation time, which varlock's static scan does not attribute to the schema.
# @optional @type=url @auditIgnore
DEV_BACKEND_URL="http://api:8000"

# Interface the dev server binds. The default is loopback, which suits a server
# run on the host. A container has to bind its own interface for the published
# port to reach it, so docker-compose-development.yml sets 0.0.0.0 there.
# @optional @type=string @auditIgnore
DEV_SERVER_HOST="127.0.0.1"

# ---------------------------------------------------------------------------
# Client-visible build metadata
#
# Only variables prefixed with VITE_ reach the browser bundle. Treat every value
# here as public. Vite inlines these at build time, so no source file references
# them by name and the audit marks them unused without @auditIgnore.
# ---------------------------------------------------------------------------

# The source revision the build reports. vite.config.ts falls back to
# `git rev-parse` in the checkout, which is absent inside a container, so the
# lifecycle supplies the value from the repository instead. Release builds pass
# the same value as a build argument.
# @optional @type=string @auditIgnore
VITE_APP_REVISION=""

# Origin the browser sends API requests to. It is inlined into the bundle and
# read by the browser, which runs on the host rather than inside a container.
#
# Empty is the correct value and is not a placeholder to fill in. The browser
# reaches the API through the origin it loaded the page from: the Vite dev
# server proxies /api, /auth, /static, /uploads, and /live to DEV_BACKEND_URL,
# and the release stack's `plane-proxy` fronts both services. Requests are then
# same-origin in both configurations.
#
# A loopback literal is wrong here twice over. It bypasses the allocated port
# (ADR-0009), so the browser is sent to a port nothing listens on; and it makes
# every request cross-origin, so it only works if CORS_ALLOWED_ORIGINS also
# names that port, which is a second hardcoded port list. Set this only for a
# genuine cross-origin deployment, where an absolute origin is the point.
# @optional @type=url @auditIgnore
VITE_API_BASE_URL=""

# Companion application origins. These describe the deployment rather than this
# application: every client links to the others by absolute origin, so the
# development lifecycle derives them once and supplies the same resolved values
# to every client it runs (ADR-0009). Declaring a per-client copy here is how
# one client ends up linking to a port another was never published on.
#
# Only the clients the development stack runs are given an origin. An empty
# value resolves to a relative URL, which is correct for an application this
# stack does not serve: the link becomes a plain missing route instead of a
# refused connection to a port nothing publishes. The remaining companion
# applications are not part of the development stack, so they stay empty.
# @optional @type=url @auditIgnore
VITE_WEB_BASE_URL=""

# The instance administration client, which the development stack does run.
# The lifecycle writes its allocated loopback origin here, because this client
# is where instance setup is completed and the workspace client links to it.
# @optional @type=url @auditIgnore
VITE_ADMIN_BASE_URL=""

# @optional @type=string @auditIgnore
VITE_ADMIN_BASE_PATH="/god-mode"

# @optional @type=url @auditIgnore
VITE_SPACE_BASE_URL=""

# @optional @type=string @auditIgnore
VITE_SPACE_BASE_PATH="/spaces"

# The collaboration relay. The work map client dials this origin over a
# websocket, and the lifecycle writes the allocated loopback port into it.
#
# An empty value is not a harmless default here. The client would resolve the
# socket against its own origin, where nothing terminates a websocket, and the
# editor would report itself read-only while the canvas still rendered: the map
# would look present and could not be edited.
# @optional @type=url @auditIgnore
VITE_LIVE_BASE_URL=""

# @optional @type=string @auditIgnore
VITE_LIVE_BASE_PATH="/live"
