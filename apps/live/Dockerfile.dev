# The workspace declares `engines.node >= 22.22.0`. Pinning the minor keeps the
# build from silently floating below it, while staying on the upstream 22.x
# alpine convention used by the other Dockerfiles.
FROM node:22.22-alpine

RUN apk add --no-cache libc6-compat
WORKDIR /app

# pnpm installs its global bin outside the default PATH. Without this, the
# `pnpm add -g` below fails with "The configured global bin directory is not in
# PATH". Dockerfile.dev for web and admin configure the same pair.
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"

COPY . .
RUN corepack enable pnpm && pnpm add -g turbo
RUN pnpm install

# The relay listens on 3003, which is the port its own env schema declares. This
# image previously exposed 3003 as well but mounted `/app/live/node_modules`,
# the pre-restructure path, so the workspace's own node_modules was shadowed by
# the host bind mount in docker-compose-development.yml.
EXPOSE 3003

ENV TURBO_TELEMETRY_DISABLED=1

VOLUME [ "/app/node_modules", "/app/apps/live/node_modules" ]

CMD ["pnpm", "dev", "--filter=live"]
