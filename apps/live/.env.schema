# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Collaboration relay configuration.
#
# This service terminates the websocket a work map opens. Without it the work
# map editor resolves to read-only: the client asks the relay for editability
# and never receives an answer, so the canvas renders for inspection but cannot
# be edited.
#
# It is an internal service rather than a browser application. The browser dials
# it directly, but it holds no client-visible configuration: everything here is
# read by the Node process.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# Origin this relay reaches the API on. It runs inside the Compose network, so
# it addresses the api by service name rather than by an allocated host port.
# @type=url @auditIgnore
API_BASE_URL="http://api:8000"

# Shared secret the relay presents to the API and requires on its own internal
# route. The api schema declares the same name, so both sides read one value.
#
# A development placeholder, not a credential: the value is loopback-only and
# the pair is created together by the lifecycle. The permanent installation
# supplies its own (ADR-0011).
# @type=string @auditIgnore
LIVE_SERVER_SECRET_KEY="secret-key"

# Internal port the relay listens on inside its container. The published host
# port is allocated separately (ADR-0009), so this value never reaches a browser.
# @optional @type=string @auditIgnore
PORT="3003"

# Path the relay is served under. The client builds its websocket URL from this
# together with the allocated host port, so the two must agree.
# @optional @type=string @auditIgnore
LIVE_BASE_PATH="/live"

# Redis backs cross-process relay control, such as closing attachments when a
# scene generation changes. The relay addresses it by service name.
# @type=string @auditIgnore
REDIS_HOST="plane-redis"

# @optional @type=number @auditIgnore
REDIS_PORT=6379

# Version the relay reports on its health route.
# @optional @type=string @auditIgnore
APP_VERSION="development"
