# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Instance administration client (Vite / React Router) configuration.
#
# This application owns instance setup: it is the surface that completes first
# run and flips the instance to ready. The workspace client refuses to render a
# workspace until that has happened, so without this service a reconciled
# baseline is unreachable through the UI.
#
# This schema declares only what is specific to this application. The companion
# origins that describe the whole deployment are one contract shared by every
# client, so they are declared once in the workspace client schema and supplied
# to this service by the lifecycle, rather than repeated here where the two
# copies could disagree.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# Interface the dev server binds. The default is loopback, which suits a server
# run on the host. A container has to bind its own interface for the published
# port to reach it, so docker-compose-development.yml sets 0.0.0.0 there.
# Read by the react-router CLI, which resolves its bind host before evaluating
# the Vite config, so varlock's static scan does not attribute it to the schema.
# @optional @type=string @auditIgnore
DEV_SERVER_HOST="127.0.0.1"

# Origin the browser sends API requests to.
#
# This is the one place this client differs from the workspace client. The
# workspace client proxies /api to DEV_BACKEND_URL through its dev server; this
# one has no proxy, because the upstream admin vite config declares none. It
# therefore needs an absolute origin, and an empty value would resolve to a
# relative URL that the admin dev server answers with its own app shell instead
# of an API response.
#
# The lifecycle writes the allocated API origin here (ADR-0009). The value below
# is the container-facing default and is not used by the development stack.
# @optional @type=url @auditIgnore
VITE_API_BASE_URL="http://api:8000"
