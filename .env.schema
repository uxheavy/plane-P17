# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Shared stack configuration for the Plane services. Consumed by
# docker-compose-local.yml, docker-compose-development.yml, and
# docker-compose-test.yml through the development lifecycle, which resolves
# this schema with `varlock run`.
#
# Host port values are defaults only. The development lifecycle allocates the
# real numbers from its own block (ADR-0009) and passes them through the
# process environment, which overrides anything declared here.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# ---------------------------------------------------------------------------
# Audit note
#
# Every item in this schema is consumed by Compose or by the containerized
# services, not by source code in this repository. `varlock audit` scans
# JavaScript, Ruby, and Go sources; it does not read Python, and it cannot see
# values that only reach a process through Compose's environment block. The
# items are therefore annotated @auditIgnore, and the development lifecycle
# validates this schema with `varlock load` instead.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
POSTGRES_USER="plane"

# @public @auditIgnore
POSTGRES_PASSWORD="company-runner-dev"

# @type=string @auditIgnore
POSTGRES_DB="plane"

# @type=string @auditIgnore
PGDATA="/var/lib/postgresql/data"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
REDIS_HOST="plane-redis"

# @type=port @auditIgnore
REDIS_PORT="6379"

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
RABBITMQ_HOST="plane-mq"

# @type=port @auditIgnore
RABBITMQ_PORT="5672"

# @type=string @auditIgnore
RABBITMQ_USER="plane"

# @public @auditIgnore
RABBITMQ_PASSWORD="company-runner-dev"

# @type=string @auditIgnore
RABBITMQ_VHOST="plane"

# ---------------------------------------------------------------------------
# Proxy listen ports
# ---------------------------------------------------------------------------

# @type=port @auditIgnore
LISTEN_HTTP_PORT=80

# @type=port @auditIgnore
LISTEN_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Development stack host ports
#
# Each is published on 127.0.0.1 only. The development lifecycle allocates
# these from its own block and injects them; the values below are the
# conventional defaults so docker-compose-local.yml runs without the lifecycle.
# ---------------------------------------------------------------------------

# @type=port @auditIgnore
DEV_REDIS_PORT=6379

# @type=port @auditIgnore
DEV_MINIO_PORT=9000

# @type=port @auditIgnore
DEV_MINIO_CONSOLE_PORT=9090

# @type=port @auditIgnore
DEV_DB_PORT=5432

# @type=port @auditIgnore
DEV_API_PORT=8000

# @type=port @auditIgnore
DEV_WEB_PORT=3000

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# @type=string @auditIgnore
AWS_REGION=""

# @public @auditIgnore
AWS_ACCESS_KEY_ID="access-key"

# @public @auditIgnore
AWS_SECRET_ACCESS_KEY="secret-key"

# @type=url @auditIgnore
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"

# Changing this requires a matching change in the proxy config for uploads when
# using the MinIO setup.
# @type=string @auditIgnore
AWS_S3_BUCKET_NAME="uploads"

# Maximum file upload limit, in bytes.
# @type=number @auditIgnore
FILE_SIZE_LIMIT=5242880

# ---------------------------------------------------------------------------
# Certificate generation
# ---------------------------------------------------------------------------

# @type=url @auditIgnore
CERT_ACME_CA="https://acme-v02.api.letsencrypt.org/directory"

# @type=string @auditIgnore
TRUSTED_PROXIES="0.0.0.0/0"

# @type=string @auditIgnore
SITE_ADDRESS=":80"

# If an SSL certificate is to be generated, set CERT_EMAIL to
# "email <EMAIL_ADDRESS>".
# @optional @type=string @auditIgnore
CERT_EMAIL=""

# For DNS-challenge certificate generation, set CERT_ACME_DNS to
# "acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>".
# @optional @type=string @auditIgnore
CERT_ACME_DNS=""

# ---------------------------------------------------------------------------
# Behavior flags
# ---------------------------------------------------------------------------

# Force HTTPS when SSL termination is handled upstream.
# @type=boolean @auditIgnore
MINIO_ENDPOINT_SSL=0

# Set to 1 when using the pre-configured MinIO setup.
# @type=boolean @auditIgnore
USE_MINIO=1

# @type=string @auditIgnore
API_KEY_RATE_LIMIT="60/minute"

# ---------------------------------------------------------------------------
# Legacy keys
#
# These remain in the schema so resolution is explicit. Without a declaration,
# a stale value left in a developer's untracked `.env` would be merged in
# silently, because varlock layers `.env` over `.env.schema`.
# ---------------------------------------------------------------------------

# Superseded by LLM_PROVIDER.
# @optional @type=string @auditIgnore
GPT_ENGINE="gpt-3.5-turbo"

# @optional @type=string @auditIgnore
OPENAI_API_BASE="https://api.openai.com/v1"

# @optional @sensitive @auditIgnore
OPENAI_API_KEY=""

# Upstream marks this as deprecated and no current code reads it.
# @optional @type=string @auditIgnore
DOCKERIZED="1"
